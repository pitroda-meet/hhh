{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "AgentRouter-openai-gateway": {
      "npm": "@ai-sdk/openai",
      "name": "AgentRouter OpenAI Gateway",
      "options": {
        "baseURL": "https://agentrouter.org/v1"
      },
      "models": {
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "glm-5.3": {
          "name": "GLM 5.3"
        }
      }
    },
    "AgentRouter-anthropic-gateway": {
      "npm": "@ai-sdk/anthropic",
      "name": "AgentRouter Anthropic Gateway",
      "options": {
        "baseURL": "https://agentrouter.org"
      },
      "models": {
        "claude-opus-5": {
          "name": "Claude Opus 5"
        },
        "claude-opus-4-8": {
          "name": "Claude Opus 4-8"
        }
      }
    }
  },
  "model": "AgentRouter-openai-gateway/gpt-6-astra"
}
