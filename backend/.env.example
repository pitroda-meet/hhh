APP_NAME="Sahay"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hackethon
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# Multi-Provider AI Gateway Configuration
# Supported AI_PROVIDER values: gemini | openai | anthropic | groq | openrouter | ollama | mock
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_BASE_URL=
AI_TEMPERATURE=0.2
AI_TIMEOUT=15
AI_FALLBACK_TO_MOCK=true
